{
  "name": "dsh-vhcu",
  "version": "1.0.0",
  "private": true,
  "description": "DSH-VHCU — on-demand vision + computer-use for DeepSeek Harness: privacy blackout, focus/frame guards, resilient Hear, 100-step macros, twenty-four tools.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.1 <0.3.0-0"
  },
  "scripts": {
    "demo": "node host/cli.mjs",
    "demo:restart": "node host/cli.mjs --kill-after --events 2",
    "test": "node --test \"contract/test/*.test.mjs\" \"host/test/*.test.mjs\"",
    "test:py": "py -3 -m unittest discover -s vision/tests -t vision -v",
    "dev": "node dev/server.mjs",
    "install:plugin": "node scripts/install.mjs",
    "install:plugin:dry": "node scripts/install.mjs --dry-run",
    "poc:uiohook": "node vision/test_uiohook.js"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
