{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vhcu:error:v1",
  "title": "Protocol-level error (either direction)",
  "allOf": [
    { "$ref": "vhcu:envelope:v1" },
    {
      "type": "object",
      "required": ["type", "code", "message", "fatal"],
      "properties": {
        "type": { "const": "error" },
        "code": {
          "enum": [
            "E_PROTO",
            "E_TIMEOUT",
            "E_BUSY",
            "E_DENIED",
            "E_UNAVAILABLE",
            "E_STATE",
            "E_CAPTURE",
            "E_PRIVACY_BLOCKED",
            "E_INTERNAL",
            "E_SEQ",
            "E_VERSION",
            "E_SHUTDOWN",
            "E_INTERRUPTED",
            "E_CONFIRM_REQUIRED",
            "E_CAPTURE_MINIMIZED",
            "E_CAPTURE_BLACK",
            "E_CAPTURE_OCCLUDED",
            "E_CAPTURE_TARGET_GONE",
            "E_CAPTURE_TARGET_NOT_FOUND",
            "E_CAPTURE_UNSUPPORTED",
            "E_COORDINATE_MISMATCH",
            "E_UIA_UNAVAILABLE",
            "E_UIA_TIMEOUT",
            "E_UIA_FAILED",
            "E_WINDOW_GONE",
            "E_ELEMENT_NOT_FOUND",
            "E_ELEMENT_STALE",
            "E_VIRTUAL_CURSOR_UNSUPPORTED",
            "E_VIRTUAL_CURSOR_FAILED",
            "E_MEMORY",
            "E_CLIPBOARD",
            "E_AUDIO_DEVICE",
            "E_FOCUS_LOST",
            "E_MACRO_FAILED",
            "E_MACRO_GENERATION_DISABLED",
            "E_MACRO_NOT_REUSABLE",
            "E_SCRIPT_WRITE_DENIED"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string" },
        "fatal": { "type": "boolean" }
      }
    }
  ]
}
